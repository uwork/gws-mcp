PROJECT_ID=your-project-id
REGION=asia-northeast1
SERVICE=gws-mcp
SECRET_NAME_CLIENT_ID=mcp-google-client-id
SECRET_NAME_CLIENT_SECRET=mcp-google-client-secret
# Cloud Run デプロイ後に取得した URL を設定 (例: https://gws-mcp-xxxx-an.a.run.app/callback)
OAUTH_REDIRECT_URI=http://localhost:8080/callback
FIRESTORE_COLLECTION=mcp_tokens
# state トークン署名キー（本番では強力なランダム文字列に変更すること）
STATE_SECRET_KEY=dev-secret-change-in-production
# MCP クライアントとして許可する redirect_uri（改行区切りで複数指定可）
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
