PROJECT_ID=your-project-id
REGION=asia-northeast1
SERVICE=gws-mcp
# カスタムドメイン（例: mcp.example.com）。設定すると Terraform・OAuth ともに自動対応。
# 未設定の場合は Cloud Run デフォルト URL を使用。
SERVICE_HOST=your-custom-domain.example.com
SECRET_NAME_CLIENT_ID=mcp-google-client-id
SECRET_NAME_CLIENT_SECRET=mcp-google-client-secret
FIRESTORE_COLLECTION=mcp_tokens
# state トークン署名キー（必須・空のままデプロイするとサーバーが起動しません）
# 生成コマンド: python -c "import secrets; print(secrets.token_hex(32))"
STATE_SECRET_KEY=
# MCP クライアントとして許可する redirect_uri（改行区切りで複数指定可）
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Googleログインを許可するドメイン（カンマ区切りで複数指定可、未設定の場合は制限なし）
# ALLOWED_GOOGLE_DOMAINS=example.com,partner.example.com
