PROJECT_ID=your-project-id
REGION=asia-northeast1
SERVICE=gws-mcp
# カスタムドメイン（例: mcp.example.com）。設定すると Terraform・OAuth ともに自動対応。
# 未設定の場合は Cloud Run デフォルト URL を使用。
SERVICE_HOST=your-custom-domain.example.com
FIRESTORE_COLLECTION=mcp_tokens
# state トークン署名キー（必須・空のままデプロイするとサーバーが起動しません）
# 生成コマンド: python -c "import secrets; print(secrets.token_hex(32))"
STATE_SECRET_KEY=
# ─── Google OAuth 資格情報（Terraform が Secret Manager へ初期投入する） ───
# GCP Console > API とサービス > 認証情報 で取得した値を設定する。
# tf-apply 実行時に Secret Manager へ書き込まれる（初回のみ）。
# ローテーションは gcloud secrets versions add または terraform apply -replace で行う。
# 注意: これらの値は Terraform state（GCS）に平文で保存される。state バケットの IAM を最小権限に保つこと。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MCP クライアントとして許可する redirect_uri（改行区切りで複数指定可）
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Googleログインを許可するドメイン（カンマ区切りで複数指定可、未設定の場合は制限なし）
# ALLOWED_GOOGLE_DOMAINS=example.com,partner.example.com
# Terraform state を保存する GCS バケット名（make tf-init で使用）
TFSTATE_BUCKET=your-project-id-tfstate
